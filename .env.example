# ── PostgreSQL local (Docker) ─────────────────────────────────
# REQUERIDA: el código no incluye fallback; la aplicación se conecta
# únicamente con DATABASE_URL. El valor siguiente es el de DESARROLLO
# LOCAL documentado en docker-compose.yml (sobreescribible).
# Para otro entorno, reemplace por su propia URL (p. ej. Neon).
DATABASE_URL=postgres://agua_renew:agua_renew_local@localhost:5432/agua_renew
# En Neon: DATABASE_URL debe ser pooled (-pooler) para la aplicación y esta
# variable debe ser directa para migraciones y pruebas administrativas.
DATABASE_URL_UNPOOLED=
NODE_ENV=development

# ── Servidor del simulador ────────────────────────────────────
PORT=3000

# ── Servidor Meta (captación de leads) ────────────────────────
# Puerto del servidor de captación (apps/meta-server). Distinto del simulador.
PORT_META=4000
# Token de verificación del webhook (Meta lo pide al suscribirse).
META_VERIFY_TOKEN=agua-renew-dev
# App Secret de la app de Meta; con él se valida la firma X-Hub-Signature-256.
# Déjelo vacío solo en desarrollo para omitir la verificación de firma.
META_APP_SECRET=
# Page Access Token para ENVIAR respuestas por Meta. Vacío → modo mock (registra
# los mensajes pero no los envía). Nunca lo versionee.
META_PAGE_ACCESS_TOKEN=
# Id de la página de Facebook (cuenta emisora para Messenger).
META_PAGE_ID=
# Id de la cuenta de Instagram Business (cuenta emisora para Instagram).
META_IG_USER_ID=
# Ventana de mensajería de Meta en horas (política de 24 h por defecto).
META_WINDOW_HOURS=24
# Control de captación y sincronización.
AUTOREPLY_ENABLED=false
META_SYNC_INTERVAL_MS=120000
# Outbox persistente: desactívelo durante una migración o rollback operativo.
OUTBOX_WORKER_ENABLED=true
OUTBOX_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=10
# Clave compartida del login del panel. En producción es obligatoria y debe
# tener 32 caracteres o más; nunca se guarda en localStorage.
ADMIN_API_TOKEN=

# ── IA DeepSeek (opcional; no incluya claves en Git) ──────────
AI_ENABLED=false
CONVERSATION_ARCHITECTURE=agent
AI_PROVIDER=deepseek
# Deje vacío para modo determinístico; complete solo con su propia clave.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_THINKING_MODE=disabled
