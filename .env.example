# ── PostgreSQL local (Docker) ─────────────────────────────────
# REQUERIDA: el código no incluye fallback; la aplicación se conecta
# únicamente con DATABASE_URL. El valor siguiente es el de DESARROLLO
# LOCAL documentado en docker-compose.yml (sobreescribible).
# Para otro entorno, reemplace por su propia URL (p. ej. Neon).
DATABASE_URL=postgres://agua_renew:agua_renew_local@localhost:5432/agua_renew
# En Neon: DATABASE_URL debe ser pooled (-pooler) para la aplicación y esta
# variable debe ser directa para migraciones y pruebas administrativas.
DATABASE_URL_UNPOOLED=
NODE_ENV=development

# ── Servidor Meta observer ────────────────────────────────────
# Local: 4000. Square Cloud publica sitios/API por el puerto 80.
PORT=4000
HOST=0.0.0.0
# Token de verificación del webhook (Meta lo pide al suscribirse).
META_VERIFY_TOKEN=agua-renew-dev
# App Secret de la app de Meta; con él se valida la firma X-Hub-Signature-256.
# Déjelo vacío solo en desarrollo para omitir la verificación de firma.
META_APP_SECRET=
# Page Access Token usado exclusivamente por consultas GET de sincronización.
META_PAGE_ACCESS_TOKEN=
# Id de la página de Facebook observada.
META_PAGE_ID=
# Id de la cuenta Instagram Business observada (opcional).
META_IG_USER_ID=
# Intervalo de sincronización read-only.
META_SYNC_INTERVAL_MS=120000
# false evita perder conversaciones que Meta Business Agent ya marcó como leídas.
META_SYNC_ONLY_UNREAD=false
# Clave compartida del login del panel. En producción es obligatoria y debe
# tener 32 caracteres o más; nunca se guarda en localStorage.
ADMIN_API_TOKEN=

# Usuario inicial del CRM. Solo se crea cuando aún no existe ningún usuario.
CRM_BOOTSTRAP_EMAIL=admin@aguarenew.local
# En producción use una clave distinta, aleatoria y de al menos 12 caracteres.
# Si se omite, el bootstrap usa ADMIN_API_TOKEN para facilitar la transición.
CRM_BOOTSTRAP_PASSWORD=
# Active únicamente detrás de un proxy controlado que reescriba X-Forwarded-For.
TRUST_PROXY=false

# ── Análisis de conversaciones con IA (opcional) ─────────────
# Acepta cualquier API compatible con OpenAI Chat Completions. Si falla, el
# webhook conserva el mensaje y usa el clasificador determinístico.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Lista de orígenes aprobados en producción, separados por coma. AI_BASE_URL
# debe coincidir con uno de ellos; no hay proveedor implícito.
AI_ALLOWED_BASE_URLS=
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=4096
# Solo defínalo si el proveedor implementa el parámetro `thinking`.
AI_THINKING_MODE=

# Worker persistente: permanece dormido entre ciclos cuando no hay trabajo.
ANALYSIS_WORKER_ACTIVE_MS=5000
ANALYSIS_WORKER_IDLE_MS=300000
# Revisión de automatizaciones CRM; no representa entrega de mensajes.
CRM_AUTOMATION_INTERVAL_MS=300000

# El análisis puede preparar borradores, pero el runtime Meta permanece en
# modo observador: nunca envía mensajes automáticamente a Meta o WhatsApp.
