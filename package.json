{
  "name": "agua-renew-commercial-domain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test",
    "test:postgres": "node scripts/run-postgres-integration.mjs",
    "test:legacy:deepseek": "set RUN_DEEPSEEK_TESTS=1&& node --test test/deepseek.integration.test.mjs",
    "start:simulator": "node apps/simulator/server.mjs",
    "start:meta": "node apps/meta-server/server.mjs",
    "dev:crm": "vite --config apps/crm/vite.config.js",
    "build:crm": "vite build --config apps/crm/vite.config.js",
    "preview:crm": "vite preview --config apps/crm/vite.config.js",
    "mock:meta": "node scripts/mock-meta.mjs",
    "migrate": "node scripts/migrate.mjs",
    "backfill:leads": "node scripts/backfill-leads.mjs --dry-run",
    "backfill:leads:apply": "node scripts/backfill-leads.mjs --apply",
    "eval": "node eval/cli.mjs --run",
    "eval:dry": "node eval/cli.mjs --dry",
    "eval:compare": "node eval/cli.mjs --compare"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  }
}
